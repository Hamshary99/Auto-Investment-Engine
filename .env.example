# ── Postgres ─────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=invest
POSTGRES_PASSWORD=investpass
POSTGRES_DB=auto_invest

# ── RabbitMQ ─────────────────────────────────────────────
RABBITMQ_URL=amqp://invest:investpass@rabbitmq:5672
RABBITMQ_USER=invest
RABBITMQ_PASSWORD=investpass
RABBITMQ_EXCHANGE=auto-invest.events

# ── Auth ─────────────────────────────────────────────────
JWT_SECRET=change-me-in-prod-please
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=10

# ── Service ports (internal) ─────────────────────────────
AUTH_PORT=3001
PORTFOLIO_PORT=3002

# ── nginx (host-facing) ──────────────────────────────────
NGINX_PORT=8080

# ── Consumer behavior ────────────────────────────────────
CONSUMER_MAX_RETRIES=3
CONSUMER_PREFETCH=10

# ── Scheduler cron expressions (UTC) ─────────────────────
CRON_NAV_SNAPSHOT=0 21 * * 1-5
CRON_RECONCILIATION=0 0 * * *
CRON_ORDER_SWEEP=*/2 * * * *

NODE_ENV=development
LOG_LEVEL=info
