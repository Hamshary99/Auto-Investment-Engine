# ============================================================================
#  Auto Invest — .env.example
#  Copy to `.env` at the repo root. Docker Compose loads it for every service.
#  All values shown are working defaults; uncomment / change only what you need.
# ============================================================================
#
#  Per-service env map (which vars each service actually reads):
#
#  auth-service       Postgres*, JWT_SECRET, JWT_EXPIRES_IN, BCRYPT_ROUNDS,
#                     AUTH_PORT, RESEND_API_KEY, EMAIL_FROM, APP_URL,
#                     EMAIL_VERIFICATION_TTL_HOURS
#  portfolio-service  Postgres*, JWT_SECRET, PORTFOLIO_PORT, RabbitMQ*,
#                     CONSUMER_MAX_RETRIES, CONSUMER_PREFETCH
#  scheduler-service  RabbitMQ*, CRON_NAV_SNAPSHOT, CRON_RECONCILIATION,
#                     CRON_ORDER_SWEEP
#  app-service        APP_PORT, JWT_SECRET, INTERNAL_AUTH_SECRET,
#                     INTERNAL_AUTH_TTL_MS, AUTH_UPSTREAM, PORTFOLIO_UPSTREAM,
#                     CORS_ORIGINS, RATE_LIMIT_*, TRUST_PROXY
#  nginx              NGINX_PORT
#
#  * "Postgres" = POSTGRES_HOST/PORT/USER/PASSWORD/DB
#    "RabbitMQ" = RABBITMQ_URL, RABBITMQ_EXCHANGE
#
#  Required for tomorrow's Postman tests (everything else has defaults):
#    Set nothing — defaults work locally. Leave RESEND_API_KEY blank to print
#    verification links to stdout instead of sending them.
# ============================================================================

# ── Postgres ─────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=invest
POSTGRES_PASSWORD=investpass
POSTGRES_DB=auto_invest

# ── RabbitMQ ─────────────────────────────────────────────
RABBITMQ_URL=amqp://invest:investpass@rabbitmq:5672
RABBITMQ_USER=invest
RABBITMQ_PASSWORD=investpass
RABBITMQ_EXCHANGE=auto-invest.events

# ── Auth (auth-service + portfolio-service + app-service) ────
JWT_SECRET=change-me-in-prod-please
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=10

# ── Email verification (auth-service only) ───────────────
# Leave RESEND_API_KEY blank for local testing — the service will log the
# verification link to stdout instead of sending. Grab a key at resend.com
# (free tier: 3k emails/mo) and verify a sender domain to actually send.
RESEND_API_KEY=
EMAIL_FROM=Auto Invest <onboarding@resend.dev>
APP_URL=http://localhost:3000
EMAIL_VERIFICATION_TTL_HOURS=24

# ── app-service (gateway) ────────────────────────────────
APP_PORT=3000
INTERNAL_AUTH_SECRET=dev-internal-secret
INTERNAL_AUTH_TTL_MS=30000
AUTH_UPSTREAM=http://auth-service:3001
PORTFOLIO_UPSTREAM=http://portfolio-service:3002
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_AUTH_MAX=10
TRUST_PROXY=false

# ── Service ports (internal) ─────────────────────────────
AUTH_PORT=3001
PORTFOLIO_PORT=3002

# ── nginx (host-facing) ──────────────────────────────────
NGINX_PORT=8080

# ── Consumer behavior (portfolio-service) ────────────────
CONSUMER_MAX_RETRIES=3
CONSUMER_PREFETCH=10

# ── Scheduler cron expressions (UTC) ─────────────────────
CRON_NAV_SNAPSHOT=0 21 * * 1-5
CRON_RECONCILIATION=0 0 * * *
CRON_ORDER_SWEEP=*/30 * * * * *
CRON_AUTO_INVEST=*/10 * * * * *

NODE_ENV=development
LOG_LEVEL=info
