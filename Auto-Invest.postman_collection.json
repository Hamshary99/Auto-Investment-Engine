{
  "info": {
    "name": "Auto Invest Engine",
    "description": "Complete API collection for the Auto Investment App. All requests go through the app-service gateway (nginx -> app-service -> {auth,portfolio}-service).\n\n## Setup\n1. Boot the stack: `docker compose up` (from `auto-invest-engine/`).\n2. Set the `baseUrl` collection variable (default: `http://localhost:8080`).\n3. Run `Register` or `Login` first — the test script auto-saves the JWT into the `token` collection variable, which the other requests use as Bearer auth.\n\n## Auth\nJWT Bearer in `Authorization: Bearer <token>` header. Tokens expire in 1h by default.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "gatewayUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "authUrl",
      "value": "http://localhost:3001",
      "type": "string"
    },
    {
      "key": "portfolioUrl",
      "value": "http://localhost:3002",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "",
      "type": "string"
    },
    {
      "key": "productTypeId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "App Gateway",
      "item": [
        {
          "name": "Health",
          "item": [
            {
              "name": "Nginx Health",
              "request": {
                "auth": {
                  "type": "noauth"
                },
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{gatewayUrl}}/health",
                  "host": [
                    "{{gatewayUrl}}"
                  ],
                  "path": [
                    "health"
                  ]
                }
              }
            }
          ]
        },
        {
          "name": "Auth",
          "item": [
            {
              "name": "Register",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const res = pm.response.json();",
                      "if (res.token) { pm.collectionVariables.set('token', res.token); }",
                      "if (res.id)    { pm.collectionVariables.set('userId', res.id); }",
                      "pm.test('201 Created', () => pm.response.to.have.status(201));"
                    ]
                  }
                }
              ],
              "request": {
                "auth": {
                  "type": "noauth"
                },
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"test+{{$timestamp}}@example.com\",\n  \"password\": \"password123\"\n}"
                },
                "url": {
                  "raw": "{{gatewayUrl}}/auth/register",
                  "host": [
                    "{{gatewayUrl}}"
                  ],
                  "path": [
                    "auth",
                    "register"
                  ]
                }
              }
            },
            {
              "name": "Login",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const res = pm.response.json();",
                      "if (res.token) { pm.collectionVariables.set('token', res.token); }",
                      "if (res.id)    { pm.collectionVariables.set('userId', res.id); }",
                      "pm.test('200 OK', () => pm.response.to.have.status(200));"
                    ]
                  }
                }
              ],
              "request": {
                "auth": {
                  "type": "noauth"
                },
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
                },
                "url": {
                  "raw": "{{gatewayUrl}}/auth/login",
                  "host": [
                    "{{gatewayUrl}}"
                  ],
                  "path": [
                    "auth",
                    "login"
                  ]
                }
              }
            },
            {
              "name": "Get Current User (/auth/me)",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{gatewayUrl}}/auth/me",
                  "host": [
                    "{{gatewayUrl}}"
                  ],
                  "path": [
                    "auth",
                    "me"
                  ]
                }
